<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action du rapport -->
    <record id="action_report_sobto_invoice" model="ir.actions.report">
        <field name="name">Facture SOBTO</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sobto_account.report_sobto_invoice_document</field>
        <field name="report_file">sobto_account.report_sobto_invoice_document</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Template QWeb -->
    <template id="report_sobto_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size:11px;font-family:Arial,sans-serif;">

                        <!-- Ville et date -->
                        <p class="text-right" style="margin-bottom:8px;">
                            <t t-out="o.company_id.city or 'Ouagadougou'"/>, le <t t-out="o.x_invoice_date_fr"/>
                        </p>

                        <!-- Titre FACTURE -->
                        <div class="text-center" style="background-color:#4472C4;padding:7px 0;margin-bottom:14px;">
                            <strong style="color:white;font-size:13px;letter-spacing:1px;">
                                FACTURE <t t-out="o.name"/>
                            </strong>
                        </div>

                        <!-- Section DOIT (client) -->
                        <table style="width:100%;margin-bottom:14px;border-collapse:collapse;">
                            <tr>
                                <td style="width:55px;vertical-align:top;font-weight:bold;padding:2px 0;">DOIT</td>
                                <td style="vertical-align:top;padding:2px 0;">
                                    <span style="font-weight:bold;">: <t t-out="o.partner_id.name"/></span><br/>
                                    <span style="margin-left:12px;display:inline-block;">
                                        <t t-if="o.partner_id.street"><t t-out="o.partner_id.street"/><br/></t>
                                        <t t-if="o.partner_id.x_rccm">N&#176; RCCM: <t t-out="o.partner_id.x_rccm"/><br/></t>
                                        <t t-if="o.partner_id.x_ifu">N&#176; IFU : <t t-out="o.partner_id.x_ifu"/><br/></t>
                                        <t t-if="o.partner_id.phone">TEL : <t t-out="o.partner_id.phone"/><br/></t>
                                        <t t-if="o.partner_id.x_dge_rni"><t t-out="o.partner_id.x_dge_rni"/></t>
                                    </span>
                                </td>
                            </tr>
                        </table>

                        <!-- Objet -->
                        <t t-if="o.x_objet">
                            <div class="text-center" style="background-color:#4472C4;padding:7px 0;margin-bottom:14px;">
                                <strong style="color:white;font-size:12px;letter-spacing:1px;">
                                    OBJET : <t t-out="o.x_objet.upper()"/>
                                </strong>
                            </div>
                        </t>

                        <!-- Variables locales -->
                        <t t-set="product_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section','line_note'))"/>
                        <t t-set="tax_lines_move" t-value="o.line_ids.filtered(lambda l: l.tax_line_id)"/>

                        <!-- Table des lignes -->
                        <table style="width:100%;border-collapse:collapse;font-size:10px;margin-bottom:0;">
                            <thead>
                                <tr style="background-color:#f2f2f2;">
                                    <th style="border:1px solid #ccc;padding:5px;text-align:center;width:12%;">Date et N&#176;<br/>de B.L</th>
                                    <th style="border:1px solid #ccc;padding:5px;text-align:center;width:12%;">Date et N&#176;<br/>de B.E</th>
                                    <th style="border:1px solid #ccc;padding:5px;text-align:center;width:14%;">N&#176; Camion</th>
                                    <th style="border:1px solid #ccc;padding:5px;text-align:center;width:11%;">Quantit&#233;s</th>
                                    <th style="border:1px solid #ccc;padding:5px;text-align:center;width:8%;">Produit</th>
                                    <th style="border:1px solid #ccc;padding:5px;text-align:center;width:18%;">Parcours</th>
                                    <th style="border:1px solid #ccc;padding:5px;text-align:center;width:9%;">Taux</th>
                                    <th style="border:1px solid #ccc;padding:5px;text-align:center;width:11%;">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="product_lines" t-as="line">
                                    <tr>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:center;vertical-align:middle;">
                                            <t t-if="line.x_date_bl"><t t-out="line.x_date_bl.strftime('%d/%m/%Y')"/><br/></t>
                                            <t t-out="line.x_numero_bl or ''"/>
                                        </td>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:center;vertical-align:middle;">
                                            <t t-if="line.x_date_be"><t t-out="line.x_date_be.strftime('%d/%m/%Y')"/><br/></t>
                                            <t t-out="line.x_numero_be or ''"/>
                                        </td>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:center;vertical-align:middle;">
                                            <t t-out="line.x_numero_camion or ''"/>
                                        </td>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:center;vertical-align:middle;">
                                            <t t-out="'{:,.0f}'.format(line.quantity).replace(',', ' ')"/>
                                            <t t-if="line.product_uom_id">&#160;<t t-out="line.product_uom_id.name"/></t>
                                        </td>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:center;vertical-align:middle;">
                                            <t t-out="line.product_id.name or line.name or ''"/>
                                        </td>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:center;vertical-align:middle;">
                                            <t t-out="line.x_parcours or ''"/>
                                        </td>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:right;vertical-align:middle;">
                                            <t t-out="('{:.3f}'.format(line.price_unit)).rstrip('0').rstrip('.').replace('.', ',')"/>
                                        </td>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:right;vertical-align:middle;">
                                            <t t-out="'{:,.0f}'.format(line.price_subtotal).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7" style="border:1px solid #ccc;padding:5px;text-align:right;font-weight:bold;">MONTANT HT</td>
                                    <td style="border:1px solid #ccc;padding:5px;text-align:right;font-weight:bold;">
                                        <t t-out="'{:,.0f}'.format(o.amount_untaxed).replace(',', ' ')"/>
                                    </td>
                                </tr>
                                <t t-foreach="tax_lines_move" t-as="tl">
                                    <tr>
                                        <td colspan="7" style="border:1px solid #ccc;padding:5px;text-align:right;">
                                            <t t-out="tl.name"/>
                                        </td>
                                        <td style="border:1px solid #ccc;padding:5px;text-align:right;">
                                            <t t-out="'{:,.0f}'.format(abs(tl.balance)).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td colspan="7" style="border:1px solid #ccc;padding:5px;text-align:right;font-weight:bold;">MONTANT TTC</td>
                                    <td style="border:1px solid #ccc;padding:5px;text-align:right;font-weight:bold;color:red;">
                                        <t t-out="'{:,.0f}'.format(o.amount_total).replace(',', ' ')"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Montant en lettres -->
                        <t t-if="o.x_montant_lettres">
                            <p style="margin-top:14px;">
                                Arr&#234;t&#233;e la pr&#233;sente facture &#224; la somme de
                                <strong><t t-out="o.x_montant_lettres"/></strong>
                            </p>
                        </t>

                        <!-- Signature -->
                        <div class="text-right" style="margin-top:40px;">
                            <strong>Directeur G&#233;n&#233;ral</strong>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
