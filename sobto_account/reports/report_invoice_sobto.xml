<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_sobto">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- ══ EN-TETE : logo a gauche ══ -->
                <div class="header">
                    <div style="padding:8px 25px;text-align:left;background-color:#ffffff;">
                        <img t-if="o.company_id.logo"
                             style="max-height:520px;max-width:100%;width:auto;height:auto;"
                             t-attf-src="/web/image/res.company/#{o.company_id.id}/logo"/>
                    </div>
                </div>

                <!-- ══ CONTENU ══ -->
                <div class="article" style="margin:0 25px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.45;color:#000;">

                    <!-- Ville et date : aligné à droite (comme référence pour le bloc CIMAF) -->
                    <div style="text-align:right;margin-bottom:8px;margin-top:0;padding-top:0;font-size:13px;color:#333;font-family:Arial,Helvetica,sans-serif;">
                        <t t-out="o.company_id.partner_id.city or o.company_id.city or 'Ouagadougou'"/>, le
                        <t t-out="o.x_invoice_date_fr"/>
                    </div>

                    <!-- CIMAF : même bandeau titre que Transit/Transit ; attachements en dessous, alignés à droite -->
                    <t t-if="o.x_invoice_type == 'cmaf'">
                        <div style="background-color:#6b9eb5;color:white;padding:8px 20px;text-align:center;font-weight:bold;font-size:16px;margin:10px 0;letter-spacing:1px;font-family:Arial,Helvetica,sans-serif;">
                            <t t-if="o.name and o.name != '/'">
                                <span t-out="o.name"/>
                            </t>
                            <t t-else="">
                                FACTURE IBTC/<t t-out="o.invoice_date.year if o.invoice_date else ''"/>/ N° —
                            </t>
                        </div>
                        <div style="text-align:right;font-size:11px;line-height:1.55;margin:0 0 10px 0;font-family:Arial,Helvetica,sans-serif;">
                            <div t-out="o.x_cmaf_attachment_1 or ''"/>
                            <div t-out="o.x_cmaf_attachment_2 or ''"/>
                            <div t-out="o.x_cmaf_attachment_3 or ''"/>
                            <div t-out="o.x_cmaf_attachment_4 or ''"/>
                        </div>
                    </t>
                    <t t-else="">
                    <div style="background-color:#6b9eb5;color:white;padding:8px 20px;text-align:center;font-weight:bold;font-size:16px;margin:10px 0;letter-spacing:1px;font-family:Arial,Helvetica,sans-serif;">
                        <t t-if="o.name and o.name != '/'">
                            <span t-out="o.name"/>
                        </t>
                        <t t-else="">
                            FACTURE IBTC/<t t-out="o.invoice_date.year if o.invoice_date else ''"/>/ N° —
                        </t>
                    </div>
                    </t>

                    <!-- DOIT : une seule marge gauche pour toutes les lignes -->
                    <div style="margin-bottom:10px;font-size:13px;text-align:left;padding-left:0;">
                        <div><strong>DOIT : <t t-out="o.partner_id.name"/></strong></div>
                        <t t-if="o.partner_id.street"><div t-out="o.partner_id.street"/></t>
                        <t t-if="o.partner_id.x_rccm"><div>N&#176; RCCM: <t t-out="o.partner_id.x_rccm"/></div></t>
                        <t t-if="o.partner_id.x_ifu"><div>N&#176; IFU : <t t-out="o.partner_id.x_ifu"/></div></t>
                        <t t-if="o.partner_id.phone"><div>TEL : <t t-out="o.partner_id.phone"/></div></t>
                        <t t-if="o.partner_id.x_dge_rni"><div t-out="o.partner_id.x_dge_rni"/></t>
                    </div>

                    <!-- Objet -->
                    <div t-if="o.x_objet" style="background-color:#6b9eb5;color:white;padding:8px 20px;text-align:center;font-weight:bold;font-size:16px;margin:10px 0;letter-spacing:1px;font-family:Arial,Helvetica,sans-serif;">
                        OBJET : <span t-out="o.x_objet.upper() if o.x_objet else ''"/>
                    </div>

                    <!-- Tableau facture Transport (8 colonnes + Taux) -->
                    <t t-if="o.x_invoice_type == 'transport'">
                        <t t-set="tr_lines" t-value="o.transport_line_ids"/>
                        <t t-set="colspan_tr" t-value="7"/>
                        <t t-set="tax_lines_tr" t-value="o.line_ids.filtered(lambda l: l.tax_line_id)"/>
                        <table style="border:1px solid #555;width:100%;border-collapse:collapse;font-size:12px;font-family:Arial,Helvetica,sans-serif;background-color:#ffffff;">
                            <thead>
                                <tr style="font-size:16px;font-family:Arial,Helvetica,sans-serif;">
                                    <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:11%;">Date et N&#176;<br/>de B.L</th>
                                    <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:11%;">Date et N&#176;<br/>de B.E</th>
                                    <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:12%;">N&#176; Camion</th>
                                    <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:10%;">Quantit&#233;s<br/>(litres)</th>
                                    <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:10%;">Produit</th>
                                    <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:18%;">Parcours</th>
                                    <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:9%;">Taux</th>
                                    <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:11%;">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="tr_lines" t-as="tline">
                                    <tr style="background-color:#ffffff;">
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                            <t t-if="tline.date_bl"><t t-out="tline.date_bl.strftime('%d/%m/%Y')"/><br/></t>
                                            <t t-out="tline.bl_number or ''"/>
                                        </td>
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                            <t t-if="tline.date_be"><t t-out="tline.date_be.strftime('%d/%m/%Y')"/><br/></t>
                                            <t t-out="tline.be_number or ''"/>
                                        </td>
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;"><t t-out="tline.camion_id.name if tline.camion_id else ''"/></td>
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                            <t t-out="'{:,.0f}'.format(tline.quantity).replace(',', ' ')"/> litres
                                        </td>
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                            <t t-if="tline.product_type == 'gasoil'">GASOIL</t>
                                            <t t-elif="tline.product_type == 'super'">SUPER</t>
                                            <t t-elif="tline.product_type == 'petrole'">P&#201;TROLE</t>
                                        </td>
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;"><t t-out="tline.parcours_id.name if tline.parcours_id else ''"/></td>
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                            <t t-out="('{:.3f}'.format(tline.taux or 0)).rstrip('0').rstrip('.').replace('.', ',')"/>
                                        </td>
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                            <t t-out="'{:,.0f}'.format(tline.montant).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color:#ffffff;">
                                    <td t-att-colspan="colspan_tr" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;">MONTANT HT</td>
                                    <td style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;"><t t-out="'{:,.0f}'.format(o.amount_untaxed).replace(',', ' ')"/></td>
                                </tr>
                                <t t-if="o.x_apply_tva">
                                <t t-foreach="tax_lines_tr" t-as="tl">
                                    <tr style="background-color:#ffffff;">
                                        <td t-att-colspan="colspan_tr" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;"><t t-out="tl.name"/></td>
                                        <td style="border:1px solid #555;padding:8px 5px;text-align:center;background-color:#ffffff;"><t t-out="'{:,.0f}'.format(abs(tl.balance)).replace(',', ' ')"/></td>
                                    </tr>
                                </t>
                                <tr style="background-color:#ffffff;">
                                    <td t-att-colspan="colspan_tr" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;">MONTANT TTC</td>
                                    <td style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;color:#CC0000;background-color:#ffffff;"><t t-out="'{:,.0f}'.format(o.amount_total).replace(',', ' ')"/></td>
                                </tr>
                                </t>
                            </tfoot>
                        </table>
                    </t>

                    <!-- Tableau CIMAF (pesée / tonne / retenue 5 %) — tout centré, en-tête répété en impression -->
                    <t t-if="o.x_invoice_type == 'cmaf'">
                        <t t-set="cim_lines" t-value="o.cmaf_line_ids"/>
                        <t t-set="cim_prod_lines" t-value="cim_lines.filtered(lambda l: l.display_type == 'product')"/>
                        <t t-set="tax_lines_cm" t-value="o.line_ids.filtered(lambda l: l.tax_line_id)"/>
                        <t t-set="sum_htva_cm" t-value="sum(cim_prod_lines.mapped('montant_htva'))"/>
                        <t t-set="sum_ret_cm" t-value="sum(cim_prod_lines.mapped('retenue_5'))"/>
                        <t t-set="sum_net_cm" t-value="sum(cim_prod_lines.mapped('total_net'))"/>
                        <t t-set="sum_poids_net_cm" t-value="sum(cim_prod_lines.mapped('poids_net'))"/>
                        <t t-set="sum_poids_tonne_cm" t-value="sum(cim_prod_lines.mapped('poids_net_tonne'))"/>
                        <t t-set="prix_ref_cm" t-value="cim_prod_lines[0].prix_tonne if cim_prod_lines else 0"/>
                        <style type="text/css">
                            .sobto-cmaf-table thead { display: table-header-group; }
                            .sobto-cmaf-table tfoot { display: table-footer-group; }
                        </style>
                        <table class="sobto-cmaf-table" style="border:1px solid #555;width:100%;border-collapse:collapse;font-size:10px;font-family:Arial,Helvetica,sans-serif;background-color:#ffffff;table-layout:fixed;">
                            <thead>
                                <tr>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">N&#176; d'ordre</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Camion</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Produit</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Ticket de pes&#233;e BF</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Date de sortie</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Poids 1&#232;re pes&#233;e</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Poids 2&#232;me pes&#233;e</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Poids Net</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Poids Net / Tonne</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Prix &#224; la tonne</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Montant HTVA</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Retenue 5%</th>
                                    <th style="border:1px solid #555;padding:4px 2px;text-align:center;font-weight:bold;vertical-align:middle;">Total Net</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="cim_lines" t-as="cl">
                                    <t t-if="cl.display_type == 'line_section'">
                                        <tr>
                                            <td colspan="13" style="border:1px solid #555;padding:6px 8px;text-align:left;vertical-align:middle;font-weight:bold;background-color:#f0f4f6;">
                                                <t t-out="cl.name or ''"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="cl.num_ordre if cl.num_ordre else ''"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="cl.camion_id.name if cl.camion_id else ''"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;">
                                                <t t-if="cl.product_type == 'tuff'">TUFF</t>
                                                <t t-elif="cl.product_type == 'gasoil'">GASOIL</t>
                                                <t t-elif="cl.product_type == 'super'">SUPER</t>
                                                <t t-elif="cl.product_type == 'petrole'">P&#201;TROLE</t>
                                            </td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="cl.ticket_pesee_bf or ''"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;">
                                                <t t-if="cl.date_sortie"><t t-out="cl.date_sortie.strftime('%d/%m/%Y')"/></t>
                                            </td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="'{:,.0f}'.format(cl.poids_1ere or 0).replace(',', ' ')"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="'{:,.0f}'.format(cl.poids_2eme or 0).replace(',', ' ')"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="'{:,.0f}'.format(cl.poids_net or 0).replace(',', ' ')"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="('{:.2f}'.format(cl.poids_net_tonne or 0)).replace('.', ',')"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="'{:,.0f}'.format(cl.prix_tonne or 0).replace(',', ' ')"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="'{:,.0f}'.format(cl.montant_htva or 0).replace(',', ' ')"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;"><t t-out="'{:,.0f}'.format(cl.retenue_5 or 0).replace(',', ' ')"/></td>
                                            <td style="border:1px solid #555;padding:4px 2px;text-align:center;vertical-align:middle;font-weight:bold;"><t t-out="'{:,.0f}'.format(cl.total_net or 0).replace(',', ' ')"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7" style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;">Sous total</td>
                                    <td style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;"><t t-out="'{:,.0f}'.format(sum_poids_net_cm).replace(',', ' ')"/></td>
                                    <td style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;"><t t-out="('{:.2f}'.format(sum_poids_tonne_cm)).replace('.', ',')"/></td>
                                    <td style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;"><t t-out="'{:,.0f}'.format(prix_ref_cm or 0).replace(',', ' ')"/></td>
                                    <td style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;"><t t-out="'{:,.0f}'.format(sum_htva_cm).replace(',', ' ')"/></td>
                                    <td style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;"><t t-out="'{:,.0f}'.format(sum_ret_cm).replace(',', ' ')"/></td>
                                    <td style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;"><t t-out="'{:,.0f}'.format(sum_net_cm).replace(',', ' ')"/></td>
                                </tr>
                                <tr>
                                    <td colspan="12" style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;">TOTAL GENERAL HT</td>
                                    <td style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;"><t t-out="'{:,.0f}'.format(sum_net_cm).replace(',', ' ')"/></td>
                                </tr>
                                <t t-if="o.x_apply_tva">
                                <t t-foreach="tax_lines_cm" t-as="tlc">
                                    <tr>
                                        <td colspan="12" style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;"><t t-out="tlc.name"/></td>
                                        <td style="border:1px solid #555;padding:6px 4px;text-align:center;vertical-align:middle;"><t t-out="'{:,.0f}'.format(abs(tlc.balance)).replace(',', ' ')"/></td>
                                    </tr>
                                </t>
                                <tr>
                                    <td colspan="12" style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;vertical-align:middle;">TOTAL GENERAL TTC</td>
                                    <td style="border:1px solid #555;padding:6px 4px;text-align:center;font-weight:bold;color:#CC0000;vertical-align:middle;"><t t-out="'{:,.0f}'.format(o.amount_total).replace(',', ' ')"/></td>
                                </tr>
                                </t>
                            </tfoot>
                        </table>
                    </t>

                    <!-- Tableau Transit : colonnes masquées si aucune ligne n'a de donnée -->
                    <t t-if="o.x_invoice_type not in ('transport', 'cmaf')">
                    <t t-set="product_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section','line_note'))"/>
                    <t t-set="tax_lines" t-value="o.line_ids.filtered(lambda l: l.tax_line_id)"/>
                    <t t-set="show_bl" t-value="any(l.x_date_bl or l.x_numero_bl for l in product_lines)"/>
                    <t t-set="show_be" t-value="any(l.x_date_be or l.x_numero_be for l in product_lines)"/>
                    <t t-set="show_camion" t-value="any(l.x_camion_id or l.x_numero_camion for l in product_lines)"/>
                    <t t-set="show_parcours" t-value="any(l.x_parcours_id or l.x_parcours for l in product_lines)"/>
                    <t t-set="colspan_foot" t-value="(1 if show_bl else 0) + (1 if show_be else 0) + (1 if show_camion else 0) + 1 + 1 + (1 if show_parcours else 0)"/>

                    <table style="border:1px solid #555;width:100%;border-collapse:collapse;font-size:12px;font-family:Arial,Helvetica,sans-serif;background-color:#ffffff;">
                        <thead>
                            <tr style="font-size:16px;font-family:Arial,Helvetica,sans-serif;">
                                <th t-if="show_bl" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:12%;">Date et N&#176;<br/>de B.L</th>
                                <th t-if="show_be" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:12%;">Date et N&#176;<br/>de B.E</th>
                                <th t-if="show_camion" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:14%;">N&#176; Camion</th>
                                <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:11%;">Quantit&#233;s<br/>(litres)</th>
                                <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:8%;">Produit</th>
                                <th t-if="show_parcours" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:18%;">Parcours</th>
                                <th style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;vertical-align:middle;width:14%;">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="product_lines" t-as="line">
                                <tr style="background-color:#ffffff;">
                                    <td t-if="show_bl" style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                        <t t-if="line.x_date_bl"><t t-out="line.x_date_bl.strftime('%d/%m/%Y')"/><br/></t>
                                        <t t-out="line.x_numero_bl or ''"/>
                                    </td>
                                    <td t-if="show_be" style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                        <t t-if="line.x_date_be"><t t-out="line.x_date_be.strftime('%d/%m/%Y')"/><br/></t>
                                        <t t-out="line.x_numero_be or ''"/>
                                    </td>
                                    <td t-if="show_camion" style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;"><t t-out="(line.x_camion_id.name or line.x_numero_camion) or ''"/></td>
                                    <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                        <t t-out="'{:,.0f}'.format(line.quantity).replace(',', ' ')"/> litres
                                    </td>
                                    <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;"><t t-out="line.product_id.name or line.name or ''"/></td>
                                    <td t-if="show_parcours" style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;"><t t-out="line.x_parcours_id.name if line.x_parcours_id else (line.x_parcours or '')"/></td>
                                    <td style="border:1px solid #555;padding:8px 5px;text-align:center;vertical-align:middle;background-color:#ffffff;">
                                        <t t-out="'{:,.0f}'.format(line.price_subtotal).replace(',', ' ')"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background-color:#ffffff;">
                                <td t-att-colspan="colspan_foot" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;">MONTANT HT</td>
                                <td style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;"><t t-out="'{:,.0f}'.format(o.amount_untaxed).replace(',', ' ')"/></td>
                            </tr>
                            <t t-if="o.x_apply_tva">
                            <t t-foreach="tax_lines" t-as="tl">
                                <tr style="background-color:#ffffff;">
                                    <td t-att-colspan="colspan_foot" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;"><t t-out="tl.name"/></td>
                                    <td style="border:1px solid #555;padding:8px 5px;text-align:center;background-color:#ffffff;"><t t-out="'{:,.0f}'.format(abs(tl.balance)).replace(',', ' ')"/></td>
                                </tr>
                            </t>
                            <tr style="background-color:#ffffff;">
                                <td t-att-colspan="colspan_foot" style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;background-color:#ffffff;">MONTANT TTC</td>
                                <td style="border:1px solid #555;padding:8px 5px;text-align:center;font-weight:bold;color:#CC0000;background-color:#ffffff;"><t t-out="'{:,.0f}'.format(o.amount_total).replace(',', ' ')"/></td>
                            </tr>
                            </t>
                        </tfoot>
                    </table>
                    </t>

                    <!-- Montant lettres (Transit / Transport : pas CIMAF) -->
                    <div t-if="o.x_montant_lettres and o.x_invoice_type != 'cmaf'" style="margin-top:28px;font-size:13px;font-family:Arial,Helvetica,sans-serif;">
                        Arr&#234;t&#233;e la pr&#233;sente facture &#224; la somme de
                        <strong t-out="o.x_montant_lettres"/>
                    </div>

                    <!-- Bloc légal + paiement réservé CIMAF -->
                    <div t-if="o.x_invoice_type == 'cmaf'" style="margin-top:28px;font-size:13px;font-family:Arial,Helvetica,sans-serif;line-height:1.55;">
                        <div t-if="o.x_montant_lettres">
                            Arr&#234;t&#233;e la pr&#233;sente facture &#224; la somme de
                            <strong t-out="o.x_montant_lettres"/>
                        </div>
                        <div t-if="o.company_id.x_cmaf_payment_rib" style="margin-top:14px;">
                            MERCI D'UTILISER LA COMMUNICATION SUIVANTE POUR VOTRE PAIEMENT :
                            <t t-if="o.name and o.name != '/'"><t t-out="o.name"/></t>
                            <t t-else="">—</t>
                            SUR LE COMPTE : <span t-out="o.company_id.x_cmaf_payment_rib"/>
                        </div>
                    </div>

                    <!-- Signature : légèrement à droite (noms + images) -->
                    <div style="margin-top:35px;font-family:Arial,Helvetica,sans-serif;text-align:right;padding-right:10%;padding-left:25%;">
                        <div style="font-weight:bold;">Directeur G&#233;n&#233;ral</div>
                        <div style="margin-top:110px;font-weight:bold;">Yaya OUATTARA</div>
                        <div t-if="o.company_id.x_invoice_signature or o.company_id.x_invoice_stamp" style="margin-top:22px;">
                            <table style="margin-left:auto;border-collapse:separate;border-spacing:16px 0;">
                                <tr>
                                    <td t-if="o.company_id.x_invoice_signature" style="text-align:right;vertical-align:bottom;padding:0;">
                                        <img t-attf-src="/web/image/res.company/#{o.company_id.id}/x_invoice_signature" style="max-height:100px;max-width:240px;" alt=""/>
                                    </td>
                                    <td t-if="o.company_id.x_invoice_stamp" style="text-align:right;vertical-align:bottom;padding:0;">
                                        <img t-attf-src="/web/image/res.company/#{o.company_id.id}/x_invoice_stamp" style="max-height:100px;max-width:240px;" alt=""/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                </div>

                <!-- ══ PIED DE PAGE SVG (CSS exact du code HTML fourni) ══ -->
                <div class="footer">
                    <div style="position:relative;overflow:hidden;min-height:120px;">
                        <div style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:0;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" preserveAspectRatio="none" style="width:100%;height:100%;display:block;">
                                <defs>
                                    <linearGradient id="ibtcWaveGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                                        <stop offset="0%" style="stop-color:#5a9fb8"/>
                                        <stop offset="50%" style="stop-color:#6b9eb5"/>
                                        <stop offset="100%" style="stop-color:#7eb5ce"/>
                                    </linearGradient>
                                </defs>
                                <rect width="1440" height="120" fill="url(#ibtcWaveGrad)"/>
                                <path fill="rgba(255,255,255,0.12)" d="M0,120 C240,80 480,60 720,75 T1440,55 L1440,120 L0,120 Z"/>
                                <path fill="rgba(255,255,255,0.2)"  d="M0,100 C360,70 720,50 1080,65 T1440,45 L1440,120 L0,120 Z"/>
                                <path fill="rgba(255,255,255,0.15)" d="M0,85  C300,55 600,40 900,55  T1440,35 L1440,120 L0,120 Z"/>
                            </svg>
                        </div>
                        <div style="position:relative;z-index:1;padding:14px 20px;text-align:center;color:#ffffff;font-size:10px;line-height:1.6;font-family:Arial,Helvetica,sans-serif;">
                            <div style="font-weight:bold;font-size:12px;letter-spacing:0.5px;margin-bottom:4px;text-transform:uppercase;">
                                <t t-out="o.company_id.name"/>
                            </div>
                            <div style="line-height:1.5;">
                                <span t-out="o.company_id.partner_id.street or o.company_id.street or ''"/>
                                <t t-if="o.company_id.partner_id.street2">, <span t-out="o.company_id.partner_id.street2"/></t>
                                <t t-if="o.company_id.phone">, Tel: <span t-out="o.company_id.phone"/></t>
                                <t t-if="o.company_id.partner_id.x_rccm">, RCCM N&#176; <span t-out="o.company_id.partner_id.x_rccm"/></t>
                                <t t-if="o.company_id.partner_id.x_ifu">, IFU N&#176; <span t-out="o.company_id.partner_id.x_ifu"/></t>
                                <t t-if="o.company_id.partner_id.bank_ids">
                                    <br/>
                                    <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                                        CPTE <t t-out="bank.bank_id.name or ''"/> N&#176;<t t-out="bank.acc_number or ''"/>
                                        <t t-if="bank.acc_holder_name"> INTITULE <t t-out="bank.acc_holder_name"/></t>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </t>
    </template>

    <!-- Même PDF SOBTO pour toutes les impressions Facturation (facture / facture avec paiements) :
         account.report_invoice_with_payments appelle account.report_invoice, où ce branchement s'applique. -->
    <!-- Branchement avant le t-if standard : évite t-elif (fragile sur certains moteurs QWeb / héritages). -->
    <template id="report_invoice_inherit_sobto" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-if][contains(@t-if, 'account.report_invoice_document')]" position="before">
            <t t-if="o._get_name_invoice_report() == 'sobto_account.report_invoice_sobto'"
               t-call="sobto_account.report_invoice_sobto"
               t-lang="'fr_FR'"/>
        </xpath>
    </template>

</odoo>
