<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_sobto">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- ══ EN-TETE : logo a gauche ══ -->
                <div class="header">
                    <div style="padding:8px 25px;text-align:left;background-color:#ffffff;">
                        <img t-if="o.company_id.logo"
                             style="max-height:180px;max-width:auto;"
                             t-attf-src="/web/image/res.company/#{o.company_id.id}/logo"/>
                    </div>
                </div>

                <!-- ══ CONTENU ══ -->
                <div class="article" style="margin:0 25px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#000;">

                    <!-- Ville et date : premier element apres le header -->
                    <div style="text-align:right;margin-bottom:8px;margin-top:0;padding-top:0;font-size:12px;color:#333;font-family:Arial,Helvetica,sans-serif;">
                        <t t-out="o.company_id.partner_id.city or o.company_id.city or 'Ouagadougou'"/>, le
                        <t t-out="o.x_invoice_date_fr"/>
                    </div>

                    <!-- Titre -->
                    <div style="background-color:#6b9eb5;color:white;padding:8px 20px;text-align:center;font-weight:bold;font-size:14px;margin:10px 0;letter-spacing:1px;">
                        FACTURE <span t-out="o.name"/>
                    </div>

                    <!-- DOIT -->
                    <div style="margin-bottom:10px;font-size:12px;">
                        <strong>DOIT : <t t-out="o.partner_id.name"/></strong>
                        <div style="margin-left:55px;">
                            <t t-if="o.partner_id.street"><div t-out="o.partner_id.street"/></t>
                            <t t-if="o.partner_id.x_rccm"><div>N&#176; RCCM: <t t-out="o.partner_id.x_rccm"/></div></t>
                            <t t-if="o.partner_id.x_ifu"><div>N&#176; IFU : <t t-out="o.partner_id.x_ifu"/></div></t>
                            <t t-if="o.partner_id.phone"><div>TEL : <t t-out="o.partner_id.phone"/></div></t>
                            <t t-if="o.partner_id.x_dge_rni"><div t-out="o.partner_id.x_dge_rni"/></t>
                        </div>
                    </div>

                    <!-- Objet -->
                    <div t-if="o.x_objet" style="background-color:#6b9eb5;color:white;padding:8px 20px;text-align:center;font-weight:bold;font-size:14px;margin:10px 0;letter-spacing:1px;">
                        OBJET : <span t-out="o.x_objet.upper() if o.x_objet else ''"/>
                    </div>

                    <!-- Tableau -->
                    <t t-set="product_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section','line_note'))"/>
                    <t t-set="tax_lines" t-value="o.line_ids.filtered(lambda l: l.tax_line_id)"/>

                    <table style="border:1px solid #555;width:100%;border-collapse:collapse;font-size:11px;">
                        <thead>
                            <tr>
                                <th style="border:1px solid #555;padding:5px;text-align:center;font-weight:bold;background-color:#f0f0f0;width:12%;">Date et N&#176;<br/>de B.L</th>
                                <th style="border:1px solid #555;padding:5px;text-align:center;font-weight:bold;background-color:#f0f0f0;width:12%;">Date et N&#176;<br/>de B.E</th>
                                <th style="border:1px solid #555;padding:5px;text-align:center;font-weight:bold;background-color:#f0f0f0;width:14%;">N&#176; Camion</th>
                                <th style="border:1px solid #555;padding:5px;text-align:center;font-weight:bold;background-color:#f0f0f0;width:11%;">Quantit&#233;s</th>
                                <th style="border:1px solid #555;padding:5px;text-align:center;font-weight:bold;background-color:#f0f0f0;width:8%;">Produit</th>
                                <th style="border:1px solid #555;padding:5px;text-align:center;font-weight:bold;background-color:#f0f0f0;width:18%;">Parcours</th>
                                <th style="border:1px solid #555;padding:5px;text-align:right;font-weight:bold;background-color:#f0f0f0;width:9%;">Taux</th>
                                <th style="border:1px solid #555;padding:5px;text-align:right;font-weight:bold;background-color:#f0f0f0;width:11%;">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="product_lines" t-as="line">
                                <tr>
                                    <td style="border:1px solid #555;padding:5px;text-align:center;vertical-align:middle;">
                                        <t t-if="line.x_date_bl"><t t-out="line.x_date_bl.strftime('%d/%m/%Y')"/><br/></t>
                                        <t t-out="line.x_numero_bl or ''"/>
                                    </td>
                                    <td style="border:1px solid #555;padding:5px;text-align:center;vertical-align:middle;">
                                        <t t-if="line.x_date_be"><t t-out="line.x_date_be.strftime('%d/%m/%Y')"/><br/></t>
                                        <t t-out="line.x_numero_be or ''"/>
                                    </td>
                                    <td style="border:1px solid #555;padding:5px;text-align:center;vertical-align:middle;"><t t-out="line.x_numero_camion or ''"/></td>
                                    <td style="border:1px solid #555;padding:5px;text-align:center;vertical-align:middle;">
                                        <t t-out="'{:,.0f}'.format(line.quantity).replace(',', ' ')"/>
                                        <t t-if="line.product_uom_id">&#160;<t t-out="line.product_uom_id.name"/></t>
                                    </td>
                                    <td style="border:1px solid #555;padding:5px;text-align:center;vertical-align:middle;"><t t-out="line.product_id.name or line.name or ''"/></td>
                                    <td style="border:1px solid #555;padding:5px;text-align:center;vertical-align:middle;"><t t-out="line.x_parcours or ''"/></td>
                                    <td style="border:1px solid #555;padding:5px;text-align:right;vertical-align:middle;">
                                        <t t-out="('{:.3f}'.format(line.price_unit)).rstrip('0').rstrip('.').replace('.', ',')"/>
                                    </td>
                                    <td style="border:1px solid #555;padding:5px;text-align:right;vertical-align:middle;">
                                        <t t-out="'{:,.0f}'.format(line.price_subtotal).replace(',', ' ')"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" style="border:1px solid #555;padding:5px;text-align:right;font-weight:bold;background-color:#f0f0f0;">MONTANT HT</td>
                                <td style="border:1px solid #555;padding:5px;text-align:right;font-weight:bold;"><t t-out="'{:,.0f}'.format(o.amount_untaxed).replace(',', ' ')"/></td>
                            </tr>
                            <t t-foreach="tax_lines" t-as="tl">
                                <tr>
                                    <td colspan="7" style="border:1px solid #555;padding:5px;text-align:right;"><t t-out="tl.name"/></td>
                                    <td style="border:1px solid #555;padding:5px;text-align:right;"><t t-out="'{:,.0f}'.format(abs(tl.balance)).replace(',', ' ')"/></td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="7" style="border:1px solid #555;padding:5px;text-align:right;font-weight:bold;background-color:#f0f0f0;">MONTANT TTC</td>
                                <td style="border:1px solid #555;padding:5px;text-align:right;font-weight:bold;color:#CC0000;"><t t-out="'{:,.0f}'.format(o.amount_total).replace(',', ' ')"/></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Montant lettres -->
                    <div t-if="o.x_montant_lettres" style="margin-top:12px;font-size:12px;font-family:Arial,Helvetica,sans-serif;">
                        Arr&#234;t&#233;e la pr&#233;sente facture &#224; la somme de
                        <strong t-out="o.x_montant_lettres"/>
                    </div>

                    <!-- Signature -->
                    <div style="text-align:right;margin-top:35px;font-family:Arial,Helvetica,sans-serif;">
                        <div style="font-weight:bold;">Directeur G&#233;n&#233;ral</div>
                        <div t-if="o.x_signataire" style="margin-top:10px;font-weight:bold;">
                            <t t-out="o.x_signataire"/>
                        </div>
                    </div>

                </div>

                <!-- ══ PIED DE PAGE SVG (CSS exact du code HTML fourni) ══ -->
                <div class="footer">
                    <div style="position:relative;overflow:hidden;min-height:120px;">
                        <div style="position:absolute;top:0;left:0;right:0;bottom:0;z-index:0;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" preserveAspectRatio="none" style="width:100%;height:100%;display:block;">
                                <defs>
                                    <linearGradient id="ibtcWaveGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                                        <stop offset="0%" style="stop-color:#5a9fb8"/>
                                        <stop offset="50%" style="stop-color:#6b9eb5"/>
                                        <stop offset="100%" style="stop-color:#7eb5ce"/>
                                    </linearGradient>
                                </defs>
                                <rect width="1440" height="120" fill="url(#ibtcWaveGrad)"/>
                                <path fill="rgba(255,255,255,0.12)" d="M0,120 C240,80 480,60 720,75 T1440,55 L1440,120 L0,120 Z"/>
                                <path fill="rgba(255,255,255,0.2)"  d="M0,100 C360,70 720,50 1080,65 T1440,45 L1440,120 L0,120 Z"/>
                                <path fill="rgba(255,255,255,0.15)" d="M0,85  C300,55 600,40 900,55  T1440,35 L1440,120 L0,120 Z"/>
                            </svg>
                        </div>
                        <div style="position:relative;z-index:1;padding:14px 20px;text-align:center;color:#ffffff;font-size:10px;line-height:1.6;font-family:Arial,Helvetica,sans-serif;">
                            <div style="font-weight:bold;font-size:12px;letter-spacing:0.5px;margin-bottom:4px;text-transform:uppercase;">
                                <t t-out="o.company_id.name"/>
                            </div>
                            <div style="line-height:1.5;">
                                <span t-out="o.company_id.partner_id.street or o.company_id.street or ''"/>
                                <t t-if="o.company_id.partner_id.street2">, <span t-out="o.company_id.partner_id.street2"/></t>
                                <t t-if="o.company_id.phone">, Tel: <span t-out="o.company_id.phone"/></t>
                                <t t-if="o.company_id.partner_id.x_rccm">, RCCM N&#176; <span t-out="o.company_id.partner_id.x_rccm"/></t>
                                <t t-if="o.company_id.partner_id.x_ifu">, IFU N&#176; <span t-out="o.company_id.partner_id.x_ifu"/></t>
                                <t t-if="o.company_id.partner_id.bank_ids">
                                    <br/>
                                    <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                                        CPTE <t t-out="bank.bank_id.name or ''"/> N&#176;<t t-out="bank.acc_number or ''"/>
                                        <t t-if="bank.acc_holder_name"> INTITULE <t t-out="bank.acc_holder_name"/></t>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </t>
    </template>

    <template id="report_invoice_inherit_sobto" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-if]" position="after">
            <t t-elif="o._get_name_invoice_report() == 'sobto_account.report_invoice_sobto'"
               t-call="sobto_account.report_invoice_sobto"
               t-lang="'fr_FR'"/>
        </xpath>
    </template>

</odoo>
