<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sobto_inherit" model="ir.ui.view">
        <field name="name">account.move.form.sobto.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Type Transit / Transport en tête de fiche -->
            <xpath expr="(//sheet//group)[1]" position="before">
                <group>
                    <field name="x_invoice_type" widget="radio" options="{'horizontal': true}"/>
                </group>
                <group string="TVA" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="x_apply_tva"/>
                </group>
                <group string="Attachement (PDF CIMAF)" invisible="x_invoice_type != 'cmaf'" colspan="2">
                    <group col="1" colspan="2">
                        <field name="x_cmaf_attachment_1" placeholder="Ligne 1"/>
                        <field name="x_cmaf_attachment_2" placeholder="Ligne 2"/>
                        <field name="x_cmaf_attachment_3" placeholder="Ligne 3"/>
                        <field name="x_cmaf_attachment_4" placeholder="Ligne 4"/>
                    </group>
                </group>
            </xpath>

            <!-- Client puis Objet sur toute la largeur (colspan 2) pour les libellés longs -->
            <xpath expr="(//sheet//field[@name='partner_id'])[1]" position="replace">
                <group colspan="2" col="2">
                    <field name="partner_id"/>
                    <field name="x_objet" colspan="2"
                           placeholder="Libellé selon le type (modifiable)"/>
                </group>
            </xpath>

            <!-- Compte : retiré dans account_move_invoice_line_transit_wrap.xml (liste + formulaire mobile) -->

            <!-- Lignes transit : masquage via groupe dans account_move_invoice_line_transit_wrap.xml
                 (le widget product_label_section_and_note_field_o2m ignore invisible sur le champ). -->

            <!-- Lignes transport & CIMAF : après le bloc transit (hors du groupe masqué) -->
            <xpath expr="//group[@name='sobto_transit_invoice_lines']" position="after">
                <group invisible="x_invoice_type != 'transport'" colspan="2" string="Lignes transport">
                    <field name="transport_line_ids" nolabel="1" colspan="2"
                           context="{'default_move_id': id}">
                        <list editable="bottom">
                            <control>
                                <create name="add_transport_line_control" string="Ajouter une ligne"/>
                                <create name="add_transport_section_control" string="Ajouter une section"
                                        context="{'default_display_type': 'line_section'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" column_invisible="True" force_save="1"/>
                            <field name="name" string="Titre / description"
                                   required="display_type == 'line_section'"
                                   invisible="display_type == 'product'"
                                   placeholder="Titre de la section"/>
                            <field name="date_bl" invisible="display_type == 'line_section'"/>
                            <field name="bl_number" invisible="display_type == 'line_section'"/>
                            <field name="date_be" invisible="display_type == 'line_section'"/>
                            <field name="be_number" invisible="display_type == 'line_section'"/>
                            <field name="camion_id" invisible="display_type == 'line_section'"/>
                            <field name="quantity" invisible="display_type == 'line_section'"/>
                            <field name="product_type" invisible="display_type == 'line_section'"/>
                            <field name="parcours_id" invisible="display_type == 'line_section'"/>
                            <field name="taux" invisible="display_type == 'line_section'"/>
                            <field name="montant" sum="Montant HT" readonly="1" invisible="display_type == 'line_section'"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right" colspan="2">
                        <field name="amount_ht_transport" readonly="1"/>
                        <field name="amount_tva_transport" readonly="1"/>
                        <field name="amount_ttc_transport" readonly="1"/>
                    </group>
                </group>
                <group invisible="x_invoice_type != 'cmaf'" colspan="2" string="Lignes CIMAF">
                    <field name="cmaf_line_ids" nolabel="1" colspan="2"
                           context="{'default_move_id': id}">
                        <list editable="bottom">
                            <control>
                                <create name="add_cmaf_line_control" string="Ajouter une ligne"/>
                                <create name="add_cmaf_section_control" string="Ajouter une section"
                                        context="{'default_display_type': 'line_section'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" column_invisible="True" force_save="1"/>
                            <field name="name" string="Titre / description"
                                   required="display_type == 'line_section'"
                                   invisible="display_type == 'product'"
                                   placeholder="Titre de la section"/>
                            <field name="num_ordre" invisible="display_type == 'line_section'"/>
                            <field name="camion_id" invisible="display_type == 'line_section'"
                                   required="display_type == 'product'"/>
                            <field name="product_type" invisible="display_type == 'line_section'"/>
                            <field name="ticket_pesee_bf" invisible="display_type == 'line_section'"/>
                            <field name="date_sortie" invisible="display_type == 'line_section'"/>
                            <field name="poids_1ere" invisible="display_type == 'line_section'"/>
                            <field name="poids_2eme" invisible="display_type == 'line_section'"/>
                            <field name="poids_net" readonly="1" invisible="display_type == 'line_section'"/>
                            <field name="poids_net_tonne" readonly="1" invisible="display_type == 'line_section'"/>
                            <field name="prix_tonne" invisible="display_type == 'line_section'"/>
                            <field name="montant_htva" readonly="1" invisible="display_type == 'line_section'"/>
                            <field name="retenue_5" readonly="1" invisible="display_type == 'line_section'"/>
                            <field name="total_net" readonly="1" invisible="display_type == 'line_section'"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right" colspan="2">
                        <field name="amount_ht_cmaf" readonly="1"/>
                        <field name="amount_tva_cmaf" readonly="1"/>
                        <field name="amount_ttc_cmaf" readonly="1"/>
                    </group>
                </group>
                <group string="Arrêté"
                       invisible="not x_montant_lettres">
                    <field name="x_montant_lettres"
                           string="Arrêtée la présente facture à la somme de"
                           readonly="1"
                           colspan="2"/>
                </group>
            </xpath>

            <!-- Colonnes BL / BE / Camion (Transit uniquement ; masquées sur Facture simple) -->
            <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='product_id']" position="before">
                <field name="x_date_bl"    optional="show" string="Date B.L" column_invisible="parent.x_invoice_type == 'simple'"/>
                <field name="x_numero_bl"  optional="show" string="N° B.L" column_invisible="parent.x_invoice_type == 'simple'"/>
                <field name="x_date_be"    optional="show" string="Date B.E" column_invisible="parent.x_invoice_type == 'simple'"/>
                <field name="x_numero_be"  optional="show" string="N° B.E" column_invisible="parent.x_invoice_type == 'simple'"/>
                <field name="x_camion_id" optional="show" string="Camion"
                       options="{'no_create': False, 'no_create_edit': False}"
                       column_invisible="parent.x_invoice_type == 'simple'"/>
            </xpath>

            <!-- Parcours / DDU / RS (Transit uniquement) -->
            <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']//list/field[@name='price_unit']" position="before">
                <field name="x_parcours_id" optional="show" string="Parcours" column_invisible="parent.x_invoice_type == 'simple'"/>
                <field name="x_total_ddu" optional="show" string="Total DDU" column_invisible="parent.x_invoice_type == 'simple'"/>
                <field name="x_rs" optional="show" string="RS" column_invisible="parent.x_invoice_type == 'simple'"/>
            </xpath>

            <!-- Transit : Montant SOBTO à la place du sous-total ; Facture simple : même règles que Odoo (HT / TTC) -->
            <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']//list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">parent.x_invoice_type == 'transit' or (parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt') and parent.company_price_include == 'tax_included')</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']//list/field[@name='price_subtotal']" position="before">
                <field name="x_montant_ligne" string="Montant" class="text-center" readonly="1"
                       column_invisible="parent.x_invoice_type != 'transit'"/>
            </xpath>

        </field>
    </record>
</odoo>
