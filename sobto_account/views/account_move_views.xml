<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sobto_inherit" model="ir.ui.view">
        <field name="name">account.move.form.sobto.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Type Transit / Transport en tête de fiche -->
            <xpath expr="(//sheet//group)[1]" position="before">
                <group>
                    <field name="x_invoice_type" widget="radio" options="{'horizontal': true}"/>
                </group>
            </xpath>

            <!-- Client et Objet : une seule ligne horizontale (group col=2) -->
            <xpath expr="(//sheet//field[@name='partner_id'])[1]" position="replace">
                <group colspan="2" col="2">
                    <field name="partner_id"/>
                    <field name="x_objet"
                           placeholder="Libellé selon le type (modifiable)"/>
                </group>
            </xpath>

            <!-- Lignes facture standard masquées en mode Transport (xpath limité à l'onglet facture pour éviter ambiguïtés) -->
            <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']" position="attributes">
                <attribute name="invisible">x_invoice_type in ('transport', 'cmaf')</attribute>
            </xpath>

            <!-- Onglet lignes transport -->
            <xpath expr="//notebook" position="inside">
                <page string="Lignes transport" name="sobto_transport_lines"
                      invisible="x_invoice_type != 'transport'">
                    <field name="transport_line_ids" nolabel="1"
                           context="{'default_move_id': id}">
                        <list editable="bottom">
                            <field name="date_bl"/>
                            <field name="bl_number"/>
                            <field name="date_be"/>
                            <field name="be_number"/>
                            <field name="camion_id"/>
                            <field name="quantity"/>
                            <field name="product_type"/>
                            <field name="parcours_id"/>
                            <field name="taux"/>
                            <field name="montant" sum="Montant HT"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right" colspan="2">
                        <field name="amount_ht_transport" readonly="1"/>
                        <field name="amount_tva_transport" readonly="1"/>
                        <field name="amount_ttc_transport" readonly="1"/>
                    </group>
                </page>
                <page string="Lignes CIMAF" name="sobto_cmaf_lines"
                      invisible="x_invoice_type != 'cmaf'">
                    <field name="cmaf_line_ids" nolabel="1"
                           context="{'default_move_id': id}">
                        <list editable="bottom">
                            <field name="num_ordre"/>
                            <field name="camion_id"/>
                            <field name="product_type"/>
                            <field name="ticket_pesee_bf"/>
                            <field name="date_sortie"/>
                            <field name="poids_1ere"/>
                            <field name="poids_2eme"/>
                            <field name="poids_net" readonly="1"/>
                            <field name="poids_net_tonne" readonly="1"/>
                            <field name="prix_tonne"/>
                            <field name="montant_htva" readonly="1"/>
                            <field name="retenue_5" readonly="1"/>
                            <field name="total_net" readonly="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right" colspan="2">
                        <field name="amount_ht_cmaf" readonly="1"/>
                        <field name="amount_tva_cmaf" readonly="1"/>
                        <field name="amount_ttc_cmaf" readonly="1"/>
                    </group>
                </page>
            </xpath>

            <!-- Colonnes BL / BE / Camion avant la description produit (Transit) -->
            <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='product_id']" position="before">
                <field name="x_date_bl"    optional="show" string="Date B.L"/>
                <field name="x_numero_bl"  optional="show" string="N° B.L"/>
                <field name="x_date_be"    optional="show" string="Date B.E"/>
                <field name="x_numero_be"  optional="show" string="N° B.E"/>
                <field name="x_numero_camion" optional="show" string="N° Camion"/>
            </xpath>

            <!-- Parcours (liste) avant le prix unitaire -->
            <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']//list/field[@name='price_unit']" position="before">
                <field name="x_parcours_id" optional="show" string="Parcours"/>
            </xpath>

            <!-- Montant HT saisissable ; masquer le sous-total standard ; contenu centré -->
            <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']//list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']//list/field[@name='price_subtotal']" position="before">
                <field name="x_montant_ligne" string="Montant" class="text-center"/>
            </xpath>

            <!-- Montant en lettres après les lignes de facture -->
            <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']" position="after">
                <group string="Arrêté">
                    <field name="x_montant_lettres"
                           string="Arrêtée la présente facture à la somme de"
                           readonly="1"
                           colspan="2"
                           invisible="not x_montant_lettres"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
