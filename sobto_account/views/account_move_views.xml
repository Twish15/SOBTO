<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sobto_inherit" model="ir.ui.view">
        <field name="name">account.move.form.sobto.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Objet : sous le client (haut de fiche), pas au-dessus des lignes -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_objet"
                       placeholder="ex: TRANSPORT D'HYDROCARBURES (CODE 404697)"/>
            </xpath>

            <!-- Colonnes BL / BE / Camion avant la description produit -->
            <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='product_id']" position="before">
                <field name="x_date_bl"    optional="show" string="Date B.L"/>
                <field name="x_numero_bl"  optional="show" string="N° B.L"/>
                <field name="x_date_be"    optional="show" string="Date B.E"/>
                <field name="x_numero_be"  optional="show" string="N° B.E"/>
                <field name="x_numero_camion" optional="show" string="N° Camion"/>
            </xpath>

            <!-- Parcours (liste) avant le prix unitaire -->
            <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='price_unit']" position="before">
                <field name="x_parcours_id" optional="show" string="Parcours"/>
            </xpath>

            <!-- Montant HT saisissable ; masquer le sous-total standard ; contenu centré -->
            <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='price_subtotal']" position="before">
                <field name="x_montant_ligne" string="Montant" class="text-center"/>
            </xpath>

            <!-- Montant en lettres après les lignes de facture -->
            <xpath expr="//field[@name='invoice_line_ids']" position="after">
                <group string="Arrêté">
                    <field name="x_montant_lettres"
                           string="Arrêtée la présente facture à la somme de"
                           readonly="1"
                           colspan="2"
                           invisible="not x_montant_lettres"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
