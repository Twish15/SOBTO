<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_sobto_invoice_pdf" model="ir.ui.view">
        <field name="name">res.company.form.inherit.sobto.invoice.pdf</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <group string="Facture PDF SOBTO" name="sobto_invoice_pdf">
                    <field name="x_invoice_signature" widget="image"/>
                    <field name="x_invoice_stamp" widget="image"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
