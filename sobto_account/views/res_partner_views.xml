<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_sobto_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.sobto.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Informations légales après le champ NIF/TVA -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="x_rccm"    string="N° RCCM"/>
                <field name="x_ifu"     string="N° IFU"/>
                <field name="x_dge_rni" string="DGE/RNI"/>
            </xpath>

        </field>
    </record>
</odoo>
